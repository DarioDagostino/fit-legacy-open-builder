# Development image for hot reload
FROM node:22-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy dependency files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Expose Vite port
EXPOSE 5178

# Start dev server with host binding
CMD ["pnpm", "dev"]
